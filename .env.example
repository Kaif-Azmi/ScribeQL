# ScribeQL - Environment Configuration Example

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database Connections (PostgreSQL + pgvector)
# app_rw has read/write privileges on the app schema
DATABASE_URL=postgresql://app_rw:password@localhost:5432/scribeql
# sql_ro has read-only privileges restricted to the demo schema
DEMO_DATABASE_URL=postgresql://sql_ro:password@localhost:5432/scribeql

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
AUTH_COOKIE_NAME=__Host-sid
AUTH_COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# Google OAuth
# In local dev, the callback must go through the Vite origin so __Host-sid is set on :5173.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# AI / LLM Configuration (Gemini)
# LLM_API_KEY is a Google AI Studio / Gemini API key (never commit the real value).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536
GLOBAL_DAILY_LLM_BUDGET=1000
